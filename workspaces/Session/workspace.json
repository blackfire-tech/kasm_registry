{
  "friendly_name": "Session",
  "description": "Session is a decentralised, end-to-end encrypted, onion-routed private messenger that needs no phone number or email to sign up.",
  "image_src": "session.png",
  "docker_registry": "https://ghcr.io/",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Messaging"
  ],
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.16.x",
      "image": "ghcr.io/blackfire-tech/kasm-session:kasm",
      "uncompressed_size_mb": 4480
    },
    {
      "version": "1.17.x",
      "image": "ghcr.io/blackfire-tech/kasm-session:kasm",
      "uncompressed_size_mb": 4480
    },
    {
      "version": "1.18.x",
      "image": "ghcr.io/blackfire-tech/kasm-session:kasm",
      "uncompressed_size_mb": 4480
    },
    {
      "version": "1.19.x",
      "image": "ghcr.io/blackfire-tech/kasm-session:kasm",
      "uncompressed_size_mb": 4480
    }
  ]
}
