{
  "friendly_name": "SimpleX Chat",
  "description": "SimpleX Chat is the first messaging network with no user identifiers of any kind — 100% private by design, with no phone number, email, or account.",
  "image_src": "simplex.png",
  "docker_registry": "https://ghcr.io/",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Messaging"
  ],
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.16.x",
      "image": "ghcr.io/blackfire-tech/kasm-simplex:kasm",
      "uncompressed_size_mb": 2800
    },
    {
      "version": "1.17.x",
      "image": "ghcr.io/blackfire-tech/kasm-simplex:kasm",
      "uncompressed_size_mb": 2800
    },
    {
      "version": "1.18.x",
      "image": "ghcr.io/blackfire-tech/kasm-simplex:kasm",
      "uncompressed_size_mb": 2800
    },
    {
      "version": "1.19.x",
      "image": "ghcr.io/blackfire-tech/kasm-simplex:kasm",
      "uncompressed_size_mb": 2800
    }
  ]
}
