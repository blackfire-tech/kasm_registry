{
  "friendly_name": "Element",
  "description": "Element is a secure, decentralised messenger and collaboration app built on the Matrix protocol — no phone number required.",
  "image_src": "element.png",
  "docker_registry": "https://ghcr.io/",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Messaging"
  ],
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    { "version": "1.16.x", "image": "ghcr.io/blackfire-tech/kasm-element:kasm", "uncompressed_size_mb": 2600 },
    { "version": "1.17.x", "image": "ghcr.io/blackfire-tech/kasm-element:kasm", "uncompressed_size_mb": 2600 },
    { "version": "1.18.x", "image": "ghcr.io/blackfire-tech/kasm-element:kasm", "uncompressed_size_mb": 2600 },
    { "version": "1.19.x", "image": "ghcr.io/blackfire-tech/kasm-element:kasm", "uncompressed_size_mb": 2600 }
  ]
}
